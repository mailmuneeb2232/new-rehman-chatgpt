# ─────────────────────────────────────────────────────────────────────────────
# Electronic Store — Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# See docs/guides/ENVIRONMENT.md for full documentation.
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Electronic Store"
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_VERSION=v1

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/electronic_store
DATABASE_REPLICA_URL=postgresql://postgres:password@localhost:5432/electronic_store
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ─────────────────────────────────────────────────────────────────────────────
# CACHE — Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────
# Generate RSA key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_ACCESS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
JWT_REFRESH_SECRET=your-32-byte-minimum-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─────────────────────────────────────────────────────────────────────────────
# FILE STORAGE — Cloudinary
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=electronic-store

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — SMTP
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="Electronic Store"
SMTP_FROM_EMAIL=noreply@electronicstore.com

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT GATEWAY — Stripe
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
COOKIE_SECRET=your-cookie-secret-minimum-32-characters
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Maximum failed login attempts before account lockout
MAX_LOGIN_ATTEMPTS=5
# Lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_OTP_MAX=3

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
DATADOG_API_KEY=
DATADOG_SERVICE_NAME=electronic-store-api

# ─────────────────────────────────────────────────────────────────────────────
# BACKGROUND JOBS — BullMQ
# ─────────────────────────────────────────────────────────────────────────────
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_DASHBOARD_ENABLED=true
QUEUE_DASHBOARD_PORT=3099

# ─────────────────────────────────────────────────────────────────────────────
# NEXT.JS FRONTEND — Public variables (prefixed NEXT_PUBLIC_)
# These are exposed to the browser. NEVER put secrets here.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME="Electronic Store"
NEXT_PUBLIC_APP_DESCRIPTION="Premium electronics marketplace"

# Google Analytics (public tracking ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mapbox (public token — read-only scope)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Stripe publishable key (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
FEATURE_3D_VIEWER_ENABLED=true
FEATURE_REVIEWS_ENABLED=true
FEATURE_WISHLIST_ENABLED=true
FEATURE_COUPONS_ENABLED=true
FEATURE_LIVE_CHAT_ENABLED=false
FEATURE_AI_RECOMMENDATIONS_ENABLED=false
