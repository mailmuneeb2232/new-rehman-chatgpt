{
  "name": "electronic-store",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise luxury electronics e-commerce monorepo",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@electronic-store/web",
    "dev:api": "turbo run dev --filter=@electronic-store/api",
    "dev:admin": "turbo run dev --filter=@electronic-store/admin",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "db:migrate": "turbo run db:migrate --filter=@electronic-store/api",
    "db:migrate:dev": "turbo run db:migrate:dev --filter=@electronic-store/api",
    "db:seed": "turbo run db:seed --filter=@electronic-store/api",
    "db:reset": "turbo run db:reset --filter=@electronic-store/api",
    "db:studio": "turbo run db:studio --filter=@electronic-store/api",
    "check-env": "tsx scripts/check-env.ts",
    "setup": "bash scripts/setup.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "turbo": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  },
  "packageManager": "pnpm@9.0.0"
}
